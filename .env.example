# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Project Settings → API Keys / Data API.
#
# Only PUBLIC values belong here. Never put the service_role / secret key
# in a NEXT_PUBLIC_ variable or anywhere in this app: VYBZ doesn't need it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Web push (phone notifications). The PUBLIC half of the VAPID key pair.
# The private half is a Supabase Edge Function secret (VAPID_PRIVATE_KEY), never stored here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
